{
    "name": "campusbook-backend",
    "version": "1.0.0",
    "description": "CampusBook API server",
    "main": "src/server.ts",
    "prisma": {
        "schema": "../database/prisma/schema.prisma"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "postinstall": "prisma skills sync || exit 0",
        "generate": "prisma generate --schema ../database/prisma/schema.prisma"
    },
    "private": true,
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "axios": "^1.21.1",
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.11.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "prisma": "^6.19.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
